rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Allow the user to read/write their own root document
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Allow the user to read/write ANY subcollection or document under their UID
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
